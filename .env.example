# Copy to .env.local. Never commit the filled-in file.

# --- runtime, optional -------------------------------------------------------
# Base64 of a Google service-account key with roles/datastore.user.
# Stores votes and Elo in Firestore, and derives the key that encrypts battle
# tokens. Without it the arena still plays; voting is disabled and tokens fall
# back to a well-known development key, so only run that way locally.
#   gcloud iam service-accounts keys create sa.json --iam-account=NAME@PROJECT.iam.gserviceaccount.com
#   base64 -w0 sa.json
GCP_SA_KEY=

# --- pipeline only, never needed at runtime ----------------------------------
# Google API key with YouTube Data API v3 enabled. Used by scripts/resolve.py to
# confirm a video is embeddable and unrestricted. Costs 1 quota unit per 50 videos.
YOUTUBE_API_KEY=

# --- entrants ----------------------------------------------------------------
# Whatever your own model needs. Pass the VARIABLE NAME to bench.mjs via
# --key-env, never the key itself on the command line.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Vertex AI entrants use gcloud ADC instead of a key:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
